#!/bin/sh
# Runs the @local-only e2e tests (real-time video export capture) before a
# push that touches export-video-related code, since those tests are
# excluded from CI (they reliably take the hosted runner down; see
# playwright.config.ts and e2e/export-raster-tiling.spec.ts). See
# CONTRIBUTING.md's "@local-only e2e tests" section for the full story.
#
# Kept tiny on purpose: the path-matching logic lives in
# scripts/pre-push-local-e2e.mjs (which reads this hook's own stdin), so this
# file only wires together the environment checks and the two commands.

if [ "$PPTX_SKIP_PREPUSH" = "1" ]; then
	echo "pptx: PPTX_SKIP_PREPUSH=1 set, skipping the local-only e2e pre-push check"
	exit 0
fi

if [ -n "$CI" ]; then
	echo "pptx: CI environment detected, skipping the local-only e2e pre-push check"
	exit 0
fi

if ! command -v node >/dev/null 2>&1; then
	echo "pptx: node not found on PATH, skipping the local-only e2e pre-push check"
	exit 0
fi

# husky runs this file with `sh -e`, so a bare command that exits non-zero
# kills the hook on the spot, before anything is printed, and the push fails
# with nothing but "pre-push script failed (code 1)". The decision script
# exits 1 for the ordinary "nothing relevant changed" case, so its status has
# to be captured inside an `||` list, which `-e` does not abort on.
decision_status=0
node scripts/pre-push-local-e2e.mjs || decision_status=$?
if [ "$decision_status" -eq 1 ]; then
	exit 0
fi
if [ "$decision_status" -ne 0 ]; then
	echo "pptx: the pre-push decision script failed (exit $decision_status); not blocking the push on it"
	exit 0
fi

if [ ! -d "$HOME/.cache/ms-playwright" ] \
	&& [ ! -d "$HOME/AppData/Local/ms-playwright" ] \
	&& [ ! -d "$LOCALAPPDATA/ms-playwright" ] \
	&& [ ! -d "$HOME/Library/Caches/ms-playwright" ]; then
	echo "pptx: Playwright browsers do not look installed, skipping the local-only e2e pre-push check (run 'bun run e2e:install' to enable it)"
	exit 0
fi

echo "pptx: running the local-only e2e tests (real-time video export capture, ~7 minutes)."
echo "pptx: set PPTX_SKIP_PREPUSH=1 to skip this push, e.g. 'PPTX_SKIP_PREPUSH=1 git push', or use 'git push --no-verify'."
if ! bun run e2e:local-only; then
	echo ""
	echo "pptx: PUSH BLOCKED: the local-only e2e tests (real-time video export) failed; see the Playwright output above."
	echo "pptx: a 'Stale build output' error means a package dist is older than its src: run the build commands it lists, then push again."
	echo "pptx: re-run them alone with 'bun run e2e:local-only'. To push anyway: 'PPTX_SKIP_PREPUSH=1 git push' or 'git push --no-verify'."
	exit 1
fi
