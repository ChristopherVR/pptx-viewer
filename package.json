{
	"name": "pptx-viewer-monorepo",
	"private": true,
	"homepage": "https://github.com/ChristopherVR/pptx-viewer",
	"bugs": {
		"url": "https://github.com/ChristopherVR/pptx-viewer/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "https://github.com/ChristopherVR/pptx-viewer.git"
	},
	"workspaces": [
		"packages/*",
		"demo",
		"demo-angular"
	],
	"scripts": {
		"install:all": "bun install",
		"demo": "cd demo && npx vite",
		"docs:dev": "cd docs && bun run docs:dev",
		"docs:build": "cd docs && bun install && bun run docs:build",
		"docs:preview": "cd docs && bun run docs:preview",
		"build": "bun run --filter 'emf-converter' build && bun run --filter 'mtx-decompressor' build && bun run --filter 'pptx-viewer-core' build && bun run --filter 'pptx-viewer-shared' build && bun run --filter 'pptx-viewer-mcp' build && bun run --filter 'pptx-viewer' build && bun run --filter 'pptx-vue-viewer' build && bun run --filter 'pptx-viewer-demo' build",
		"typecheck": "bun run --filter '*' typecheck",
		"test": "bash scripts/test-all.sh",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"pack:emf": "cd packages/emf-converter && bun run pack",
		"pack:mtx": "cd packages/mtx-decompressor && bun run pack",
		"pack:shared": "cd packages/shared && bun run pack",
		"pack:core": "cd packages/core && bun run pack",
		"pack:react": "cd packages/react && bun run pack",
		"pack:vue": "cd packages/vue && bun run pack",
		"outdated": "bun outdated --filter '*'",
		"update": "bun update --latest",
		"collab": "bun demo/collab-server.mjs",
		"e2e": "playwright test",
		"e2e:install": "playwright install --with-deps chromium",
		"e2e:ui": "playwright test --ui",
		"prepare": "husky"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@types/three": "^0.184.1",
		"husky": "^9.1.7",
		"lib0": "^0.2.117",
		"lint-staged": "^17.0.7",
		"oxfmt": "^0.54.0",
		"oxlint": "^1.69.0",
		"pptx-viewer": "workspace:*",
		"pptx-viewer-core": "workspace:*",
		"typescript": "^6.0.3",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.31"
	},
	"optionalDependencies": {
		"@react-three/drei": "^10.7.7",
		"@react-three/fiber": "^9.6.1",
		"three": "^0.184.0"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,jsonc,css,scss,less,html,vue,yaml,toml,md,mdx,graphql}": "oxfmt --check",
		"*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": "oxlint --deny-warnings"
	}
}
