{
	"name": "pptx-viewer-monorepo",
	"private": true,
	"homepage": "https://github.com/ChristopherVR/pptx-viewer",
	"bugs": {
		"url": "https://github.com/ChristopherVR/pptx-viewer/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "https://github.com/ChristopherVR/pptx-viewer.git"
	},
	"workspaces": [
		"packages/*",
		"demos/*"
	],
	"scripts": {
		"install:all": "bun install",
		"demo": "cd demos/demo-react && npx vite",
		"demo:vue": "cd demos/demo-vue && npx vite",
		"demo:angular": "cd demos/demo-angular && npx vite",
		"demo:vanilla": "cd demos/demo-vanilla && npx vite",
		"demo:svelte": "cd demos/demo-svelte && npx vite",
		"docs:dev": "cd docs && bun run docs:dev",
		"docs:build": "cd docs && bun install && bun run docs:build",
		"docs:preview": "cd docs && bun run docs:preview",
		"build": "bun run --filter 'pptx-viewer-core' build && bun run --filter 'pptx-viewer-shared' build && bun run --filter 'pptx-viewer-mcp' build && bun run --filter 'pptx-react-viewer' build && bun run --filter 'pptx-vue-viewer' build && bun run --filter 'pptx-angular-viewer' build && bun run --filter 'pptx-vanilla-viewer' build && bun run --filter 'pptx-svelte-viewer' build && bun run --filter '@christophervr/pptx-viewer' build && bun run --filter 'pptx-react-demo' build",
		"typecheck": "bun run --filter '*' typecheck",
		"test": "bash scripts/test-all.sh",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"pack:shared": "cd packages/shared && bun run pack",
		"pack:core": "cd packages/core && bun run pack",
		"pack:react": "cd packages/react && bun run pack",
		"pack:vue": "cd packages/vue && bun run pack",
		"pack:angular": "cd packages/angular && bun run pack",
		"pack:vanilla": "cd packages/vanilla && bun run pack",
		"pack:svelte": "cd packages/svelte && bun run pack",
		"pack:cli": "cd packages/cli && bun run pack",
		"changelog:latest": "bunx git-cliff --config cliff-root.toml --latest --strip header",
		"changelog:unreleased": "bunx git-cliff --config cliff-root.toml --unreleased",
		"release:plan": "node scripts/release-plan.mjs",
		"outdated": "bun outdated --filter '*'",
		"update": "bun update --latest",
		"collab": "bun demos/demo-react/collab-server.mjs",
		"e2e": "bun run e2e:contract && playwright test",
		"e2e:contract": "node scripts/check-e2e-neutrality.mjs",
		"test:e2e-contract": "node --test scripts/check-e2e-neutrality.test.mjs",
		"e2e:install": "playwright install --with-deps chromium",
		"e2e:ui": "playwright test --ui",
		"docs:screenshots": "playwright test --config=playwright.capture.config.ts e2e/capture-user-guide-assets.spec.ts e2e/capture-user-guide-gifs.spec.ts",
		"prepare": "husky"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@types/three": "^0.185.1",
		"@typescript/typescript6": "^6.0.2",
		"husky": "^9.1.7",
		"jszip": "^3.10.1",
		"lib0": "^0.2.117",
		"lint-staged": "^17.0.8",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.70.0",
		"pptx-react-viewer": "workspace:*",
		"pptx-viewer-core": "workspace:*",
		"rollup": "^4.53.2",
		"rollup-plugin-dts": "^6.4.1",
		"typescript": "^6.0.3",
		"unrun": "^0.3.1",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.31"
	},
	"optionalDependencies": {
		"@react-three/drei": "^10.7.7",
		"@react-three/fiber": "^9.6.1",
		"three": "^0.185.1"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,jsonc,css,scss,less,html,vue,yaml,toml,md,mdx,graphql}": "oxfmt",
		"*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": "oxlint --deny-warnings"
	}
}
