{
	"name": "pptx-viewer-monorepo",
	"private": true,
	"homepage": "https://github.com/ChristopherVR/pptx-viewer",
	"bugs": {
		"url": "https://github.com/ChristopherVR/pptx-viewer/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "https://github.com/ChristopherVR/pptx-viewer.git"
	},
	"workspaces": [
		"packages/*",
		"demos/*"
	],
	"scripts": {
		"install:all": "bun install",
		"demo": "cd demos/demo-react && npx vite",
		"demo:vue": "cd demos/demo-vue && npx vite",
		"demo:angular": "cd demos/demo-angular && npx vite",
		"demo:vanilla": "cd demos/demo-vanilla && npx vite",
		"demo:three-parity": "bun run --cwd demos/demo-three-parity dev",
		"demo:svelte": "cd demos/demo-svelte && npx vite",
		"docs:dev": "cd docs && bun run docs:dev",
		"docs:build": "cd docs && bun install && bun run docs:build",
		"docs:preview": "cd docs && bun run docs:preview",
		"docs:customization": "bun scripts/sync-customization-docs.ts",
		"build": "bun run --filter 'pptx-viewer-core' build && bun run --filter 'pptx-viewer-shared' build && bun run --filter 'pptx-viewer-locales' build && bun run --filter 'pptx-viewer-mcp' build && bun run --filter 'pptx-react-viewer' build && bun run --filter 'pptx-vue-viewer' build && bun run --filter 'pptx-angular-viewer' build && bun run --filter 'pptx-vanilla-viewer' build && bun run --filter 'pptx-svelte-viewer' build && bun run --filter '@christophervr/pptx-viewer' build && bun run --filter 'pptx-react-demo' build",
		"locales:generate": "bun scripts/generate-complete-locales.ts",
		"fonts:catalogue": "node scripts/update-google-fonts-catalogue.mjs",
		"typecheck": "bun run --filter '*' typecheck",
		"test": "bash scripts/test-all.sh",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"pack:shared": "cd packages/shared && bun run pack",
		"pack:core": "cd packages/core && bun run pack",
		"pack:react": "cd packages/react && bun run pack",
		"pack:vue": "cd packages/vue && bun run pack",
		"pack:angular": "cd packages/angular && bun run pack",
		"pack:vanilla": "cd packages/vanilla && bun run pack",
		"pack:svelte": "cd packages/svelte && bun run pack",
		"pack:cli": "cd packages/cli && bun run pack",
		"changelog:latest": "bunx git-cliff --config cliff-root.toml --latest --strip header",
		"changelog:unreleased": "bunx git-cliff --config cliff-root.toml --unreleased",
		"release:plan": "node scripts/release-plan.mjs",
		"outdated": "bun outdated --filter '*'",
		"update": "bun update --latest",
		"collab": "bun demos/demo-react/collab-server.mjs",
		"e2e": "bun run e2e:contract && playwright test",
		"e2e:contract": "node scripts/check-e2e-neutrality.mjs",
		"e2e:local-only": "bun run e2e:contract && playwright test --grep @local-only --workers=1",
		"test:e2e-contract": "node --test scripts/check-e2e-neutrality.test.mjs",
		"e2e:install": "playwright install --with-deps chromium",
		"e2e:packaged": "bun run e2e:contract && playwright test --config=playwright.packaged.config.ts",
		"e2e:ui": "playwright test --ui",
		"docs:screenshots": "playwright test --config=playwright.capture.config.ts e2e/capture-user-guide-assets.spec.ts e2e/capture-user-guide-gifs.spec.ts",
		"prepare": "husky",
		"test:scripts": "node --test scripts/*.test.mjs",
		"test:locale-subpaths": "node scripts/check-locale-subpaths.mjs",
		"check:published-types": "node scripts/check-published-shared-refs.mjs",
		"test:core-package": "node scripts/check-core-package.mjs",
		"test:binding-packages": "node scripts/check-binding-packages.mjs"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.62",
		"@ai-sdk/react": "^4.0.130",
		"@ai-sdk/svelte": "^5.0.127",
		"@ai-sdk/vue": "^4.0.127",
		"@angular/common": "^22.2.1",
		"@angular/compiler": "^22.2.1",
		"@angular/compiler-cli": "^22.2.1",
		"@angular/core": "^22.2.1",
		"@angular/platform-browser": "^22.2.1",
		"@angular/platform-browser-dynamic": "^22.2.1",
		"@microsoft/api-extractor": "^7.59.3",
		"@modelcontextprotocol/sdk": "^1.32.0",
		"@vitejs/plugin-react": "^6.1.1",
		"html2canvas-pro": "^2.5.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-i18next": "^17.0.15",
		"svelte": "^5.57.1",
		"vue-i18n": "^11.4.13",
		"vue-tsc": "^3.3.12",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@types/three": "^0.186.0",
		"@typescript/typescript6": "^6.0.2",
		"@vitest/coverage-v8": "^5.0.3",
		"ai": "^7.0.127",
		"husky": "^9.1.7",
		"jszip": "^3.10.2",
		"lib0": "^0.2.119",
		"lint-staged": "^17.6.0",
		"oxfmt": "0.71.0",
		"oxlint": "^1.86.0",
		"pptx-react-viewer": "workspace:*",
		"pptx-viewer-core": "workspace:*",
		"rollup": "^4.64.0",
		"rollup-plugin-dts": "^6.5.1",
		"typescript": "^6.0.3",
		"unrun": "^0.3.1",
		"y-protocols": "^1.0.7",
		"y-websocket": "^3.1.0",
		"yjs": "^13.6.33"
	},
	"optionalDependencies": {
		"@react-three/drei": "^10.7.9",
		"@react-three/fiber": "^9.8.1",
		"three": "^0.186.1"
	},
	"overrides": {
		"ai": "^7.0.127",
		"zod": "^4.6.5"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,jsonc,css,scss,less,html,vue,yaml,toml,md,mdx,graphql}": "oxfmt",
		"*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": "oxlint --deny-warnings"
	}
}
