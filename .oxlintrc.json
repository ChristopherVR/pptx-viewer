{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["react", "import", "vitest", "promise", "jsx-a11y", "typescript"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn",
		"pedantic": "warn",
		"style": "warn"
	},
	"rules": {
		// ── Forbid `any`: keep the type system honest. Per-line escape hatches
		//    via `// eslint-disable-next-line @typescript-eslint/no-explicit-any`
		//    remain available for genuinely unavoidable cases (currently: the
		//    `XmlObject` alias documents itself as the escape hatch for
		//    fast-xml-parser output). New code should reach for `unknown` +
		//    narrowing, concrete types, or `XmlObject` instead. ──
		"typescript/no-explicit-any": "error",

		// ── Suspicious: disable rules that don't apply ──
		"react/react-in-jsx-scope": "off",
		"import/no-unassigned-import": "off",
		"unicorn/consistent-function-scoping": "off",
		"unicorn/require-module-specifiers": "off",

		// ── Pedantic: disable overly strict / type-info-dependent rules ──
		"max-classes-per-file": "off",
		"max-depth": "off",
		"max-lines": "off",
		"max-lines-per-function": "off",
		"max-nested-callbacks": "off",
		"no-warning-comments": "off",
		"no-inline-comments": "off",
		"no-negated-condition": "off",
		"sort-vars": "off",
		"radix": "off",
		"require-await": "off",
		"no-throw-literal": "off",
		"import/max-dependencies": "off",
		"typescript/strict-boolean-expressions": "off",
		"typescript/no-unsafe-argument": "off",
		"typescript/no-unsafe-assignment": "off",
		"typescript/no-unsafe-call": "off",
		"typescript/no-unsafe-member-access": "off",
		"typescript/no-unsafe-return": "off",
		"typescript/no-deprecated": "off",
		"typescript/no-misused-promises": "off",
		// ── Typescript-plugin stylistic rules: noisy and not worth churn ──
		"typescript/array-type": "off",
		"typescript/consistent-type-imports": "off",
		"typescript/no-inferrable-types": "off",
		"typescript/consistent-generic-constructors": "off",
		"typescript/consistent-indexed-object-style": "off",
		"typescript/prefer-for-of": "off",
		"typescript/no-empty-interface": "off",
		"typescript/no-extraneous-class": "off",
		"typescript/ban-ts-comment": "off",
		"typescript/no-confusing-void-expression": "off",
		"typescript/no-mixed-enums": "off",
		"typescript/restrict-plus-operands": "off",
		"typescript/switch-exhaustiveness-check": "off",
		"unicorn/no-array-callback-reference": "off",
		"unicorn/no-object-as-default-parameter": "off",
		"unicorn/prefer-top-level-await": "off",

		// ── Perf: disable impractical rules ──
		"no-await-in-loop": "off",
		"react/no-array-index-key": "off",

		// ── Test: disable overly strict test rules ──
		"jest/max-expects": "off",
		"jest/max-nested-describe": "off",
		"jest/no-conditional-in-test": "off",
		"jest/no-hooks": "off",
		"jest/require-hook": "off",
		"jest/require-top-level-describe": "off",
		"jest/prefer-each": "off",
		"jest/no-conditional-expect": "off",
		"jest/require-to-throw-message": "off",
		"jest/valid-expect": "off",
		"jest/expect-expect": "off",
		"jest/valid-title": "off",
		"jest/prefer-equality-matcher": "off",
		"jest/no-large-snapshots": "off",
		"jest/no-restricted-jest-methods": "off",
		"jest/no-restricted-matchers": "off",
		// Flags tests that end in a for-loop with inner expects; stylistic only.
		"jest/prefer-ending-with-an-expect": "off",

		// ── Conflicting rule pairs: pick one, disable the other ──
		// prefer-strict-boolean-matchers wants `.toBe(true)`; prefer-to-be-truthy
		// wants `.toBeTruthy()`. We use `.toBeTruthy()` because many assertions
		// target non-boolean values (strings, IDs) where strict equality fails.
		"vitest/prefer-strict-boolean-matchers": "off",
		// Codebase imports from 'vitest', not '@jest/globals'.
		"jest/prefer-importing-jest-globals": "off",

		// ── Style: disable overly opinionated rules ──
		"sort-keys": "off",
		"sort-imports": "off",
		"no-ternary": "off",
		"no-continue": "off",
		"no-labels": "off",
		"no-nested-ternary": "off",
		"no-magic-numbers": "off",
		"capitalized-comments": "off",
		"id-length": "off",
		"max-params": "off",
		"max-statements": "off",
		"init-declarations": "off",
		"vars-on-top": "off",
		"func-names": "off",
		"func-style": "off",
		"guard-for-in": "off",
		"no-multi-assign": "off",
		"no-multi-str": "off",
		"no-return-assign": "off",
		"no-new-func": "off",
		"no-template-curly-in-string": "off",
		"no-label-var": "off",
		"no-extra-label": "off",
		"new-cap": "off",
		"arrow-body-style": "off",
		"prefer-destructuring": "off",
		"prefer-rest-params": "off",
		"no-duplicate-imports": "off",
		"import/no-named-export": "off",
		"import/group-exports": "off",
		"import/exports-last": "off",
		"import/prefer-default-export": "off",
		"import/no-nodejs-modules": "off",
		"import/no-namespace": "off",
		"import/no-anonymous-default-export": "off",
		"import/no-named-default": "off",
		"import/no-mutable-exports": "off",
		"react/no-set-state": "off",
		"react/jsx-props-no-spreading": "off",
		"react/jsx-handler-names": "off",
		"react/jsx-max-depth": "off",
		"react/jsx-pascal-case": "off",
		"react/state-in-constructor": "off",
		"react/prefer-es6-class": "off",
		"react/no-redundant-should-component-update": "off",
		"typescript/consistent-type-definitions": "off",
		"typescript/parameter-properties": "off",
		"unicorn/no-null": "off",
		"unicorn/no-await-expression-member": "off",
		"unicorn/filename-case": "off",
		"unicorn/no-unreadable-array-destructuring": "off",
		"unicorn/no-array-method-this-argument": "off",
		"unicorn/prefer-ternary": "off",
		"unicorn/prefer-spread": "off",
		"unicorn/no-nested-ternary": "off",
		"promise/avoid-new": "off",
		"promise/prefer-await-to-callbacks": "off",
		"promise/prefer-await-to-then": "off",
		"promise/param-names": "off",
		"promise/no-nesting": "off",
		"vitest/consistent-test-filename": "off",
		"vitest/prefer-describe-function-title": "off",
		"vitest/no-importing-vitest-globals": "off",
		"vitest/prefer-called-times": "off",
		// vi.fn() infers its signature from the impl arg in nearly every site;
		// requiring an explicit type parameter just to satisfy the rule produces
		// redundant noise. Disable in favor of letting inference work.
		"vitest/require-mock-type-parameters": "off",
		"jest/prefer-called-with": "off",

		// ── oxlint 1.62 introduced vitest/* counterparts of already-disabled jest/* rules ──
		// Codebase doesn't use expect.hasAssertions(); these rules don't match our convention.
		"jest/prefer-expect-assertions": "off",
		"vitest/prefer-expect-assertions": "off",
		"vitest/max-expects": "off",
		"vitest/no-conditional-in-test": "off",
		"vitest/no-conditional-expect": "off",
		"vitest/no-hooks": "off",
		"vitest/expect-expect": "off",
		"vitest/require-top-level-describe": "off",
		"vitest/max-nested-describe": "off",
		"vitest/valid-title": "off",
		// Codebase uses _-prefixed locals to mark intentionally unused values.
		"no-underscore-dangle": "off",

		// ── Accessibility: disable rules requiring significant UI changes ──
		// These should be enabled incrementally as components are updated
		"jsx-a11y/no-static-element-interactions": "off",
		"jsx-a11y/click-events-have-key-events": "off",
		"jsx-a11y/media-has-caption": "off",
		"jsx-a11y/label-has-associated-control": "off",
		"jsx-a11y/prefer-tag-over-role": "off",
		"jsx-a11y/no-autofocus": "off",

		// ── Accessibility: downgrade to warn (from correctness=error) ──
		"jsx-a11y/alt-text": "warn",
		"jsx-a11y/anchor-has-content": "warn",
		"jsx-a11y/anchor-is-valid": "warn",
		"jsx-a11y/aria-activedescendant-has-tabindex": "warn",
		"jsx-a11y/aria-props": "warn",
		"jsx-a11y/aria-proptypes": "warn",
		"jsx-a11y/aria-role": "warn",
		"jsx-a11y/aria-unsupported-elements": "warn",
		"jsx-a11y/autocomplete-valid": "warn",
		"jsx-a11y/heading-has-content": "warn",
		"jsx-a11y/html-has-lang": "warn",
		"jsx-a11y/iframe-has-title": "warn",
		"jsx-a11y/img-redundant-alt": "warn",
		"jsx-a11y/lang": "warn",
		"jsx-a11y/mouse-events-have-key-events": "warn",
		"jsx-a11y/no-access-key": "warn",
		"jsx-a11y/no-aria-hidden-on-focusable": "warn",
		"jsx-a11y/no-distracting-elements": "warn",
		// Removed: these 3 rules are not yet available in the current oxlint version
		// "jsx-a11y/no-interactive-element-to-noninteractive-role": "warn",
		// "jsx-a11y/no-noninteractive-element-interactions": "warn",
		// "jsx-a11y/no-noninteractive-element-to-interactive-role": "warn",
		"jsx-a11y/no-noninteractive-tabindex": "warn",
		"jsx-a11y/no-redundant-roles": "warn",
		"jsx-a11y/role-has-required-aria-props": "warn",
		"jsx-a11y/role-supports-aria-props": "warn",
		"jsx-a11y/scope": "warn",
		"jsx-a11y/tabindex-no-positive": "warn"
	},
	"settings": {
		"jsx-a11y": {
			"polymorphicPropName": null,
			"components": {},
			"attributes": {}
		},
		"react": {
			"formComponents": [],
			"linkComponents": [],
			"version": "19",
			"componentWrapperFunctions": []
		},
		"jsdoc": {
			"ignorePrivate": false,
			"ignoreInternal": false,
			"ignoreReplacesDocs": true,
			"overrideReplacesDocs": true,
			"augmentsExtendsReplacesDocs": false,
			"implementsReplacesDocs": false,
			"exemptDestructuredRootsFromChecks": false,
			"tagNamePreference": {}
		},
		"vitest": {
			"typecheck": false
		}
	},
	"env": {
		"builtin": true
	},
	"globals": {},
	"ignorePatterns": ["dist", "node_modules", "*.min.js", "*.d.ts"]
}
