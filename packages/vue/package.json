{
	"name": "pptx-vue-viewer",
	"version": "2.21.3",
	"description": "Vue 3 PowerPoint viewer and editor component: render, edit, and export PPTX slides in the browser.",
	"keywords": [
		"editor",
		"export",
		"office",
		"openxml",
		"powerpoint",
		"ppt",
		"pptx",
		"presentation",
		"slides",
		"slideshow",
		"viewer",
		"vue",
		"vue-component",
		"vue3"
	],
	"homepage": "https://github.com/ChristopherVR/pptx-viewer",
	"bugs": {
		"url": "https://github.com/ChristopherVR/pptx-viewer/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "https://github.com/ChristopherVR/pptx-viewer.git",
		"directory": "packages/vue"
	},
	"files": [
		"dist/",
		"CHANGELOG.md",
		"LICENSE",
		"NOTICE",
		"README.md"
	],
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./viewer": {
			"types": "./dist/viewer/index.d.ts",
			"import": "./dist/viewer/index.js",
			"require": "./dist/viewer/index.cjs"
		},
		"./internals": {
			"types": "./dist/internals.d.ts",
			"import": "./dist/internals.js",
			"require": "./dist/internals.cjs"
		},
		"./i18n": {
			"types": "./dist/i18n.d.ts",
			"import": "./dist/i18n.js",
			"require": "./dist/i18n.cjs"
		},
		"./styles": "./dist/pptx-vue-viewer.css",
		"./styles.css": "./dist/pptx-vue-viewer.css"
	},
	"scripts": {
		"build": "vite build && npx @tailwindcss/cli -i src/styles/pptx-vue-viewer.css -o dist/pptx-vue-viewer.css --minify && node ../../scripts/compress-dist.mjs dist",
		"dev": "vite build --watch",
		"typecheck": "vue-tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"pack": "bun run build && bun pm pack"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"dompurify": "^3.4.13",
		"html2canvas-pro": "^2.3.2",
		"jspdf": "^4.2.1",
		"lucide-vue-next": "^1.0.0",
		"pptx-viewer-mcp": "workspace:*",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@ai-sdk/vue": "^4.0.65",
		"@rollup/plugin-terser": "^1.0.0",
		"@tailwindcss/cli": "^4.3.3",
		"@types/dompurify": "^3.2.0",
		"@types/three": "^0.185.4",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vue/compiler-sfc": "^3.5.40",
		"@vue/test-utils": "^2.4.11",
		"happy-dom": "^20.11.1",
		"jsdom": "^30.0.1",
		"pptx-viewer-core": "workspace:*",
		"pptx-viewer-shared": "workspace:*",
		"tailwindcss": "^4.3.3",
		"terser": "^5.49.0",
		"three": "^0.185.1",
		"typescript": "6.0.3",
		"vite": "^8.2.1",
		"vite-plugin-dts": "^5.0.3",
		"vitest": "^4.1.10",
		"vue-tsc": "^3.3.9",
		"y-webrtc": "^10.3.0",
		"y-websocket": "^3.1.0",
		"yjs": "^13.6.32"
	},
	"peerDependencies": {
		"@ai-sdk/vue": "^4.0.65",
		"ai": ">=6 <8",
		"fast-xml-parser": "^5.10.1",
		"jszip": "^3.10.1",
		"three": "^0.185.1",
		"vue": "^3.5.39",
		"vue-i18n": "^11.4.6"
	},
	"peerDependenciesMeta": {
		"@ai-sdk/vue": {
			"optional": true
		},
		"ai": {
			"optional": true
		},
		"three": {
			"optional": true
		}
	},
	"optionalDependencies": {
		"three": "^0.185.1",
		"y-webrtc": "^10.3.0",
		"y-websocket": "^3.1.0",
		"yjs": "^13.6.32"
	}
}
