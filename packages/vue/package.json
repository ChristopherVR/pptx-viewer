{
	"name": "pptx-vue-viewer",
	"version": "1.1.23",
	"description": "Vue 3 PowerPoint viewer and editor component: render, edit, and export PPTX slides in the browser.",
	"keywords": [
		"editor",
		"export",
		"office",
		"openxml",
		"powerpoint",
		"ppt",
		"pptx",
		"presentation",
		"slides",
		"slideshow",
		"viewer",
		"vue",
		"vue-component",
		"vue3"
	],
	"homepage": "https://github.com/ChristopherVR/pptx-viewer",
	"bugs": {
		"url": "https://github.com/ChristopherVR/pptx-viewer/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "https://github.com/ChristopherVR/pptx-viewer.git",
		"directory": "packages/vue"
	},
	"files": [
		"dist/",
		"CHANGELOG.md",
		"LICENSE",
		"NOTICE",
		"README.md"
	],
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./viewer": {
			"types": "./dist/viewer/index.d.ts",
			"import": "./dist/viewer/index.js",
			"require": "./dist/viewer/index.cjs"
		},
		"./styles": "./dist/pptx-vue-viewer.css",
		"./styles.css": "./dist/pptx-vue-viewer.css"
	},
	"scripts": {
		"build": "vite build && npx @tailwindcss/cli -i src/styles/pptx-vue-viewer.css -o dist/pptx-vue-viewer.css --minify && node ../../scripts/compress-dist.mjs dist",
		"dev": "vite build --watch",
		"typecheck": "vue-tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"pack": "bun run build && bun pm pack"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"dompurify": "^3.4.11",
		"html2canvas-pro": "^2.0.4",
		"jspdf": "^4.2.1",
		"lucide-vue-next": "^1.0.0",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@rollup/plugin-terser": "^1.0.0",
		"@tailwindcss/cli": "^4.3.1",
		"@types/dompurify": "^3.2.0",
		"@types/three": "^0.185.0",
		"@vitejs/plugin-vue": "^6.0.7",
		"@vue/test-utils": "^2.4.11",
		"happy-dom": "^20.10.6",
		"pptx-viewer-core": "workspace:*",
		"pptx-viewer-shared": "workspace:*",
		"tailwindcss": "^4.3.1",
		"terser": "^5.48.0",
		"three": "^0.185.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-dts": "^5.0.3",
		"vitest": "^4.1.9",
		"vue-tsc": "^3.3.5"
	},
	"peerDependencies": {
		"fast-xml-parser": "^5.8.0",
		"jszip": "^3.10.1",
		"three": "^0.185.0",
		"vue": "^3.5.0"
	},
	"peerDependenciesMeta": {
		"three": {
			"optional": true
		}
	},
	"optionalDependencies": {
		"three": "^0.185.0",
		"y-websocket": "^3.0.0",
		"yjs": "^13.6.31"
	}
}
