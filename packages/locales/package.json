{
	"name": "pptx-viewer-locales",
	"version": "0.1.0",
	"private": true,
	"description": "Internal complete locale dictionaries referenced by the pptx-viewer demos",
	"keywords": [
		"i18n",
		"localization",
		"powerpoint",
		"pptx",
		"translation"
	],
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./fr": {
			"types": "./dist/fr/index.d.ts",
			"import": "./dist/fr/index.js",
			"require": "./dist/fr/index.cjs"
		},
		"./es": {
			"types": "./dist/es/index.d.ts",
			"import": "./dist/es/index.js",
			"require": "./dist/es/index.cjs"
		},
		"./de": {
			"types": "./dist/de/index.d.ts",
			"import": "./dist/de/index.js",
			"require": "./dist/de/index.cjs"
		}
	},
	"scripts": {
		"build": "tsup && tsdown && node ../../scripts/merge-declarations.mjs",
		"dev": "tsup --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"tsdown": "^0.22.12",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
