{
	"name": "pptx-viewer-shared",
	"version": "0.1.0",
	"private": true,
	"description": "INTERNAL, non-published package. Framework-agnostic viewer logic shared by the React, Vue, Angular, Svelte, and vanilla JS pptx-viewer bindings (theme, rendering, editing state). Bundled into each binding; never published to npm.",
	"keywords": [
		"openxml",
		"powerpoint",
		"pptx",
		"presentation",
		"shared",
		"viewer"
	],
	"homepage": "https://github.com/ChristopherVR/pptx-viewer",
	"bugs": {
		"url": "https://github.com/ChristopherVR/pptx-viewer/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "https://github.com/ChristopherVR/pptx-viewer.git",
		"directory": "packages/shared"
	},
	"files": [
		"dist/",
		"LICENSE",
		"NOTICE",
		"README.md"
	],
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./theme": {
			"types": "./dist/theme/index.d.ts",
			"import": "./dist/theme/index.mjs",
			"require": "./dist/theme/index.js"
		},
		"./loader": {
			"types": "./dist/loader/index.d.ts",
			"import": "./dist/loader/index.mjs",
			"require": "./dist/loader/index.js"
		},
		"./smartart-3d": {
			"types": "./dist/smartart-3d/index.d.ts",
			"import": "./dist/smartart-3d/index.mjs",
			"require": "./dist/smartart-3d/index.js"
		},
		"./i18n": {
			"types": "./dist/i18n/index.d.ts",
			"import": "./dist/i18n/index.mjs",
			"require": "./dist/i18n/index.js"
		},
		"./ai": {
			"types": "./dist/ai/index.d.ts",
			"import": "./dist/ai/index.mjs",
			"require": "./dist/ai/index.js"
		}
	},
	"scripts": {
		"build": "tsup && tsdown && node ../../scripts/merge-declarations.mjs",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit --pretty",
		"test": "vitest run",
		"test:watch": "vitest",
		"pack": "bun run build && bun pm pack"
	},
	"dependencies": {
		"dompurify": "^3.4.12",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@ai-sdk/openai-compatible": "^3.0.12",
		"@types/dompurify": "^3.2.0",
		"@types/three": "^0.185.1",
		"ai": "^7.0.44",
		"fake-indexeddb": "^6.2.2",
		"pptx-viewer-core": "workspace:*",
		"pptx-viewer-mcp": "workspace:*",
		"three": "^0.185.1",
		"tsdown": "^0.22.14",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10",
		"yjs": "^13.6.31",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"ai": ">=6.0.0 <8",
		"pptx-viewer-core": "workspace:*",
		"pptx-viewer-mcp": "workspace:*",
		"three": "^0.185.1"
	},
	"peerDependenciesMeta": {
		"ai": {
			"optional": true
		},
		"three": {
			"optional": true
		}
	}
}
