{
	"name": "@christophervr/pptx-viewer",
	"version": "2.2.0",
	"description": "Interactive installer for the pptx-viewer family of packages (React, Vue, Angular, Svelte, vanilla JS, the core engine, the MCP server). Also a drop-in for pptx-react-viewer: importing this package re-exports the React component.",
	"keywords": [
		"angular",
		"cli",
		"create",
		"installer",
		"office",
		"openxml",
		"powerpoint",
		"ppt",
		"pptx",
		"presentation",
		"react",
		"scaffold",
		"slides",
		"vue"
	],
	"homepage": "https://github.com/ChristopherVR/pptx-viewer",
	"bugs": {
		"url": "https://github.com/ChristopherVR/pptx-viewer/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "https://github.com/ChristopherVR/pptx-viewer.git",
		"directory": "packages/cli"
	},
	"bin": {
		"pptx-viewer": "./dist/cli.mjs"
	},
	"files": [
		"dist/",
		"CHANGELOG.md",
		"LICENSE",
		"NOTICE",
		"README.md"
	],
	"main": "dist/index.mjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup && tsdown && node ../../scripts/merge-declarations.mjs && node -e \"require('fs').chmodSync('dist/cli.mjs', 0o755)\"",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit --pretty",
		"test": "vitest run",
		"test:watch": "vitest",
		"pack": "bun run build && bun pm pack"
	},
	"dependencies": {
		"pptx-react-viewer": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"tsdown": "^0.22.14",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"@ai-sdk/react": "^4.0.59",
		"ai": ">=6 <8",
		"fast-xml-parser": "^5.10.1",
		"framer-motion": "^12.42.2 || ^13.1.1",
		"i18next": "^26.3.6",
		"jspdf": "^4.2.1",
		"jszip": "^3.10.1",
		"lucide-react": "^1.24.0",
		"react": "^18.2.0 || ^19.0.0",
		"react-dom": "^18.2.0 || ^19.0.0",
		"react-i18next": "^17.0.9",
		"react-icons": "^5.7.0"
	},
	"peerDependenciesMeta": {
		"@ai-sdk/react": {
			"optional": true
		},
		"ai": {
			"optional": true
		},
		"fast-xml-parser": {
			"optional": true
		},
		"framer-motion": {
			"optional": true
		},
		"i18next": {
			"optional": true
		},
		"jspdf": {
			"optional": true
		},
		"jszip": {
			"optional": true
		},
		"lucide-react": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"react-i18next": {
			"optional": true
		},
		"react-icons": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=18"
	}
}
