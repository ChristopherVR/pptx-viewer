{
	"name": "@christophervr/pptx-viewer",
	"version": "1.6.0",
	"description": "Interactive installer for the pptx-viewer family of packages: React, Vue, Angular, Svelte, and vanilla JS viewer components, the framework-agnostic core engine, and the MCP server.",
	"keywords": [
		"angular",
		"cli",
		"create",
		"installer",
		"office",
		"openxml",
		"powerpoint",
		"ppt",
		"pptx",
		"presentation",
		"react",
		"scaffold",
		"slides",
		"vue"
	],
	"homepage": "https://github.com/ChristopherVR/pptx-viewer",
	"bugs": {
		"url": "https://github.com/ChristopherVR/pptx-viewer/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "https://github.com/ChristopherVR/pptx-viewer.git",
		"directory": "packages/cli"
	},
	"bin": {
		"pptx-viewer": "./dist/index.mjs"
	},
	"files": [
		"dist/",
		"CHANGELOG.md",
		"LICENSE",
		"NOTICE",
		"README.md"
	],
	"main": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup && tsdown && node ../../scripts/merge-declarations.mjs && node -e \"require('fs').chmodSync('dist/index.mjs', 0o755)\"",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit --pretty",
		"test": "vitest run",
		"test:watch": "vitest",
		"pack": "bun run build && bun pm pack"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"tsdown": "^0.22.14",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=18"
	}
}
