{
	"name": "pptx-viewer-core",
	"version": "4.9.1",
	"description": "pptx-viewer core engine: parse, edit, serialize, and convert PowerPoint .pptx files. Framework-agnostic TypeScript SDK (thin entry point over @christophervr/ooxml-core/pptx).",
	"keywords": [
		"angular",
		"converter",
		"markdown",
		"office",
		"ooxml",
		"openxml",
		"parser",
		"powerpoint",
		"ppt",
		"pptx",
		"pptx-viewer",
		"presentation",
		"react",
		"sdk",
		"serializer",
		"slides",
		"typescript",
		"vue"
	],
	"homepage": "https://github.com/ChristopherVR/pptx-viewer",
	"bugs": {
		"url": "https://github.com/ChristopherVR/pptx-viewer/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "https://github.com/ChristopherVR/pptx-viewer.git",
		"directory": "packages/core"
	},
	"bin": {
		"pptx": "./dist/cli/index.mjs"
	},
	"files": [
		"dist/",
		"CHANGELOG.md",
		"LICENSE",
		"NOTICE",
		"README.md"
	],
	"main": "dist/index.mjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./converter": {
			"types": "./dist/converter/index.d.ts",
			"import": "./dist/converter/index.mjs",
			"require": "./dist/converter/index.js"
		},
		"./cli": {
			"types": "./dist/cli/index.d.ts",
			"import": "./dist/cli/index.mjs",
			"require": "./dist/cli/index.js"
		},
		"./signature-node": {
			"types": "./dist/signature-node/index.d.ts",
			"import": "./dist/signature-node/index.mjs",
			"require": "./dist/signature-node/index.js"
		}
	},
	"scripts": {
		"build": "node scripts/build-entries.mjs",
		"typecheck": "tsc --noEmit --pretty",
		"test": "vitest run",
		"pack": "bun run build && bun pm pack"
	},
	"dependencies": {
		"@christophervr/ooxml-core": "^0.1.0"
	},
	"devDependencies": {
		"@napi-rs/canvas": "^1.0.9",
		"@types/node": "^22.0.0",
		"@types/node-forge": "^1.3.14",
		"@xmldom/xmldom": "^0.9.12",
		"emf-converter": "^3.3.0",
		"fast-xml-parser": "^5.11.1",
		"jszip": "^3.10.2",
		"node-forge": "^1.4.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0",
		"xml-crypto": "^6.1.2"
	},
	"peerDependencies": {
		"@napi-rs/canvas": "^1.0.9",
		"@xmldom/xmldom": "^0.8.0",
		"node-forge": "^1.3.0",
		"xml-crypto": "^6.0.0"
	},
	"peerDependenciesMeta": {
		"@napi-rs/canvas": {
			"optional": true
		},
		"node-forge": {
			"optional": true
		},
		"xml-crypto": {
			"optional": true
		},
		"@xmldom/xmldom": {
			"optional": true
		}
	}
}
