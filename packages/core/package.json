{
	"name": "pptx-viewer-core",
	"version": "2.0.11",
	"description": "PowerPoint PPTX engine: parse, edit, serialize, and convert .pptx files. Framework-agnostic TypeScript SDK.",
	"keywords": [
		"angular",
		"converter",
		"markdown",
		"office",
		"ooxml",
		"openxml",
		"parser",
		"powerpoint",
		"ppt",
		"pptx",
		"presentation",
		"react",
		"sdk",
		"serializer",
		"slides",
		"typescript",
		"vue"
	],
	"homepage": "https://github.com/ChristopherVR/pptx-viewer",
	"bugs": {
		"url": "https://github.com/ChristopherVR/pptx-viewer/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "https://github.com/ChristopherVR/pptx-viewer.git",
		"directory": "packages/core"
	},
	"bin": {
		"pptx": "./dist/cli/index.mjs"
	},
	"files": [
		"dist/",
		"CHANGELOG.md",
		"LICENSE",
		"NOTICE",
		"README.md"
	],
	"main": "dist/index.mjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./converter": {
			"types": "./dist/converter/index.d.ts",
			"import": "./dist/converter/index.mjs",
			"require": "./dist/converter/index.js"
		},
		"./cli": {
			"types": "./dist/cli/index.d.ts",
			"import": "./dist/cli/index.mjs",
			"require": "./dist/cli/index.js"
		},
		"./signature-node": {
			"types": "./dist/signature-node/index.d.ts",
			"import": "./dist/signature-node/index.mjs",
			"require": "./dist/signature-node/index.js"
		}
	},
	"scripts": {
		"build": "tsup && tsdown && node ../../scripts/merge-declarations.mjs",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit --pretty",
		"test": "vitest run",
		"test:watch": "vitest",
		"pack": "bun run build && bun pm pack"
	},
	"dependencies": {
		"emf-converter": "^2.0.2",
		"fast-xml-parser": "^5.10.1",
		"jszip": "^3.10.1",
		"mtx-decompressor": "^1.6.0"
	},
	"devDependencies": {
		"@types/node-forge": "^1.3.14",
		"@xmldom/xmldom": "^0.9.10",
		"node-forge": "^1.4.0",
		"tsdown": "^0.22.14",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10",
		"xml-crypto": "^6.1.2"
	},
	"peerDependencies": {
		"@xmldom/xmldom": "^0.8.0",
		"node-forge": "^1.3.0",
		"xml-crypto": "^6.0.0"
	},
	"peerDependenciesMeta": {
		"node-forge": {
			"optional": true
		},
		"xml-crypto": {
			"optional": true
		},
		"@xmldom/xmldom": {
			"optional": true
		}
	}
}
