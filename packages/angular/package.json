{
	"name": "pptx-angular-viewer",
	"version": "1.14.0",
	"description": "Angular PowerPoint viewer and editor component: render, edit, and export PPTX slides in the browser.",
	"keywords": [
		"angular",
		"angular-component",
		"editor",
		"export",
		"office",
		"openxml",
		"powerpoint",
		"ppt",
		"pptx",
		"presentation",
		"slides",
		"slideshow",
		"viewer"
	],
	"homepage": "https://github.com/ChristopherVR/pptx-viewer",
	"bugs": {
		"url": "https://github.com/ChristopherVR/pptx-viewer/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "https://github.com/ChristopherVR/pptx-viewer.git",
		"directory": "packages/angular"
	},
	"exports": {
		"./styles": "./pptx-angular-viewer.css",
		"./styles.css": "./pptx-angular-viewer.css"
	},
	"scripts": {
		"inline-shared": "node ./scripts/inline-shared.mjs",
		"finalize-dist": "node ./scripts/finalize-dist.mjs",
		"build": "bun run inline-shared && ng-packagr -p ng-package.json && bun run finalize-dist && bun run build:css",
		"build:css": "tailwindcss -i src/styles/pptx-angular-viewer.css -o dist/pptx-angular-viewer.css --minify",
		"dev": "bun run inline-shared && ng-packagr -p ng-package.json --watch",
		"typecheck": "bun run inline-shared && tsc --noEmit -p tsconfig.lib.json",
		"test": "bun run inline-shared && vitest run",
		"test:watch": "bun run inline-shared && vitest",
		"pack": "bun run build && cd dist && bun pm pack"
	},
	"dependencies": {
		"@lucide/angular": "^1.23.0",
		"dompurify": "^3.4.11",
		"fast-xml-parser": "^5.9.2",
		"html2canvas-pro": "^2.0.4",
		"jspdf": "^4.2.1",
		"jszip": "^3.10.1",
		"pptx-viewer-core": "workspace:*",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@analogjs/vite-plugin-angular": "^2.6.2",
		"@angular/common": "^22.0.5",
		"@angular/compiler": "^22.0.4",
		"@angular/compiler-cli": "^22.0.4",
		"@angular/core": "^22.0.5",
		"@angular/platform-browser": "^22.0.4",
		"@tailwindcss/cli": "^4.3.1",
		"@types/three": "^0.185.0",
		"happy-dom": "^20.10.6",
		"jsdom": "^29.1.1",
		"ng-packagr": "^22.0.0",
		"pptx-viewer-core": "workspace:*",
		"rxjs": "^7.8.2",
		"tailwindcss": "^4.3.2",
		"three": "^0.185.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9",
		"y-webrtc": "^10.3.0",
		"y-websocket": "^3.0.0",
		"yjs": "^13.6.31",
		"zone.js": "^0.16.2"
	},
	"peerDependencies": {
		"@angular/common": "^22.0.5",
		"@angular/core": "^22.0.1",
		"@ngx-translate/core": "^18.0.0",
		"rxjs": "^7.8.0",
		"three": "^0.185.1",
		"y-webrtc": "^10.3.0",
		"y-websocket": "^3.0.0",
		"yjs": "^13.6.31"
	},
	"peerDependenciesMeta": {
		"three": {
			"optional": true
		},
		"y-webrtc": {
			"optional": true
		},
		"y-websocket": {
			"optional": true
		},
		"yjs": {
			"optional": true
		}
	}
}
