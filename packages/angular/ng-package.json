{
	"$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
	"dest": "dist",
	"allowedNonPeerDependencies": [
		"@lucide/angular",
		"html2canvas-pro",
		"jspdf",
		"jszip",
		"fast-xml-parser",
		"dompurify",
		"pptx-viewer-core"
	],
	"assets": [
